    "test:lyrics": "node ./scripts/check-lyrics-renderers.cjs && node ./scripts/check-playback-performance.cjs && node ./scripts/check-amll-clusters.mjs && node ./scripts/check-amll-scroll.mjs",
    "build:spicy-webview": "node ./scripts/build-spicy-webview-bundle.mjs",
    "build:amll-webview": "node ./scripts/build-amll-webview-bundle.mjs",
    "test:vault": "node ./scripts/check-vault-ttml.cjs && node ./scripts/check-vault-sharing.cjs && node ./scripts/check-vault-artwork.cjs && node ./scripts/check-desktop-vault.cjs",
