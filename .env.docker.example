# Copy this file to .env before running Docker Compose.
# The published amd64 image is used by default; pin KINESYNC_IMAGE to a version
# (for example :1.0.6) when you want repeatable upgrades.
KINESYNC_IMAGE=ghcr.io/kineticron/kinesync-desktop-bridge:latest
# Both values are optional. KineSync creates a persistent pairing key itself,
# and the app view needs no password while it remains bound to localhost.
BRIDGE_KEY=
KINESYNC_WEB_USER=kinesync
# Set a password before changing KINESYNC_WEB_BIND_ADDRESS to a LAN address.
KINESYNC_WEB_PASSWORD=
KINESYNC_CONFIG_PATH=./.kinesync-config
# `always` checks GHCR for a newer :latest image whenever the service starts.
KINESYNC_PULL_POLICY=always
# Change this if another Compose project already uses the `kinesync` name.
KINESYNC_CONTAINER_NAME=kinesync
# Change these if ports 3000 or 3443 are already occupied on the Docker host.
KINESYNC_WEB_PORT=3000
KINESYNC_WEB_HTTPS_PORT=3443
# The bridge is reachable from the LAN so a phone can pair with the host.
KINESYNC_BRIDGE_BIND_ADDRESS=0.0.0.0
# On Linux, use `id -u` and `id -g` when your host user should own /config.
# The defaults work with Docker Desktop; change them for host-owned Linux files.
PUID=568
PGID=568
TZ=America/New_York
