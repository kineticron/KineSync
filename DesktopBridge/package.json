{
  "name": "desktopbridge",
  "productName": "KineSync",
  "version": "1.2.0",
  "description": "Desktop bridge for KineSync — streams playback metadata and synced lyrics from Windows to your phone.",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:windows": "electron-forge make --platform=win32 --arch=x64",
    "publish": "electron-forge publish",
    "postinstall": "node scripts/postinstall.js",
    "lint": "node scripts/check-syntax.cjs",
    "test": "node --test test/*.test.js",
    "relay": "node scripts/start-relay.js",
    "relay:ngrok": "node scripts/start-relay-ngrok.js",
    "check:lyrics-sources": "node scripts/check-lyrics-source-health.js",
    "build:native-media": "npm ci --ignore-scripts --prefix native/windows-media-session && npm run rebuild:electron --prefix native/windows-media-session",
    "build:seek-helper": "dotnet build native/spotify-seek-helper/spotify-seek-helper.csproj -c Release",
    "build:native": "concurrently --raw \"npm run build:native-media\" \"npm run build:seek-helper\"",
    "diagnose:seek": "node scripts/diagnose-seek.js",
    "create:native-manifest": "node scripts/create-native-manifest.js"
  },
  "keywords": [],
  "author": {
    "name": "Kineticron",
    "email": "kineticrondev@gmail.com"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kineticron/KineSync.git",
    "directory": "DesktopBridge"
  },
  "homepage": "https://github.com/Kineticron/KineSync#readme",
  "bugs": "https://github.com/Kineticron/KineSync/issues",
  "dependencies": {
    "@homebridge/dbus-native": "^0.7.9",
    "@ngrok/ngrok": "1.7.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "concurrently": "10.0.6",
    "electron": "44.7.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
